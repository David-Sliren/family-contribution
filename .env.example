# Private ---------------------------------------------------------------------------
MONGODB_URI=# La URI de conexión a tu base de datos MongoDB, por ejemplo: mongodb://localhost:27017/tu-base-de-datos
BETTER_AUTH_SECRET= # La clave secreta para Better Auth, puedes generar una con: openssl rand -base64 32
BETTER_AUTH_URL= # La url base de tu app, por ejemplo: https://tu-app.com
BASE_URL=# La url base de tu app, por ejemplo: https://tu-app.com
VERCEL_URL=# Vercel la proporciona automáticamente, no es necesario que la agregues aquí

# Pasarelas de pago
MP_ACCESS_TOKEN=# El token de acceso de tu cuenta de Mercado Pago

# Cloudinary (subida de imágenes)
CLOUDINARY_CLOUD_NAME=# El nombre de tu cloud de Cloudinary
CLOUDINARY_APY_KEY=# Tu API Key de Cloudinary
CLOUDINARY_APY_SECRECT=# Tu API Secret de Cloudinary

# Google OAuth (login con Better Auth)
GOOGLE_CLIENT_ID=# El Client ID de tu proyecto en Google Cloud Console
GOOGLE_CLIENT_SECRET=# El Client Secret de tu proyecto en Google Cloud Console

# Correos transaccionales (Gmail SMTP vía Nodemailer)
GMAIL_USER=# Correo Gmail que envía los correos, por ejemplo: mi-cuenta@gmail.com
GMAIL_APP_PASSWORD=# Contraseña de aplicación de Google (https://myaccount.google.com/apppasswords); requiere verificación en dos pasos

# Public ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-EB0GSL8123